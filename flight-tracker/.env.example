# Data source: "opensky" (free, default), "mock" (synthetic offline data), or
# "flightaware" (AeroAPI, paid).
DATA_PROVIDER=opensky

# FlightAware AeroAPI key — required only when DATA_PROVIDER=flightaware.
# Get one at https://www.flightaware.com/aeroapi/portal/
AERO_API_KEY=

# Secondary source used automatically if AeroAPI errors or its budget is hit:
# "opensky" (default), "mock", or "none" to disable.
AERO_FALLBACK=opensky

# Hard cap on AeroAPI requests per calendar month (cost guard). 0 = unlimited.
# AeroAPI bills ~$0.05 per positions request, so set this to your budget.
AERO_MONTHLY_BUDGET=0

# Override the AeroAPI base URL (used for testing against a stub). Leave unset
# in production.
# AERO_API_BASE=https://aeroapi.flightaware.com/aeroapi

# Server poll interval in milliseconds (AeroAPI refreshes ~1-4x/min; keep >= 15000).
POLL_INTERVAL_MS=20000
